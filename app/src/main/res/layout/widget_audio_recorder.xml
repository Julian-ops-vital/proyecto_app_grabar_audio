<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Botón / Ícono central interactivo -->
    <ImageView
        android:id="@+id/iv_widget_btn"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/widget_recording_bg"
        android:contentDescription="@string/widget_title"
        android:padding="12dp"
        android:src="@drawable/ic_mic" />

    <TextView
        android:id="@+id/tv_widget_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="@string/widget_tap_to_record"
        android:textColor="@color/primary_dark"
        android:textSize="12sp"
        android:textStyle="bold" />

</LinearLayout>

